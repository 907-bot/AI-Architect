# AI Architect — Environment Variables
# Copy this file to .env and fill in your values

# ── OpenAI (required for AI Architect chatbot) ────────────────────────────────
OPENAI_API_KEY=sk-your-key-here

# ── Ollama (local LLM for building generation) ────────────────────────────────
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# ── Redis ─────────────────────────────────────────────────────────────────────
RENDER_QUEUE_REDIS_URL=redis://127.0.0.1:6379/0

# ── Blender (auto-detected on macOS) ─────────────────────────────────────────
# BLENDER_PATH=/Applications/Blender.app/Contents/MacOS/Blender
